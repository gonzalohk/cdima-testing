  if (!notes) return [];
  const match = notes.match(/===DATOS_JSON===\s*([\s\S]+?)\s*===FIN_DATOS_JSON===/);
  if (!match) return [];
  try {
    const data = JSON.parse(match[1]);
    return Array.isArray(data.documentos) ? data.documentos : [];
  } catch {
    return [];
